DATABASE_URL=postgresql://god:god@localhost:5432/god
# Hosted Postgres (e.g. Aiven): add sslmode=require and keep the pool under the service's connection limit
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/god?sslmode=require&connection_limit=5&pool_timeout=20
TEST_DATABASE_URL=postgresql://god:god@localhost:5432/god_testsuite
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=4000
HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:4000
SEED_FOUNDER_EMAIL=founder@god.local
SEED_PASSWORD=Password123!
LOG_LEVEL=info

# Browser push notifications: generate with `npx web-push generate-vapid-keys`.
# Leave empty to turn push off. Use the same pair everywhere that shares a database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
