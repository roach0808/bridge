// God System database schema (§3). Constraints that Prisma cannot express
// (exclusion constraint, check constraints, ends_at trigger) live in the
// hand-written SQL of the migrations.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  founder
  manager
  associate
  expert
}

enum CallStatus {
  on_scheduling
  scheduled
  confirmed
  on_rescheduling
  ongoing
  finished
  invoice_submit
  invoice_approve
  process_to_bank
  cancelled
}

enum ProfileStatus {
  pending
  approved
  rejected
}

/// A profile's standing on one expert network platform; no row = not_registered.
enum PlatformRegistration {
  not_registered
  registered
  banned
}

enum ChatMessageKind {
  text
  todo_done
}

/// open → done (the taker ticks it) → completed (the giver confirms).
enum TodoStatus {
  open
  done
  completed
}

enum AvatarAudience {
  founder
  manager
  associate
  expert
  profile
}

enum BlockKind {
  available
  unavailable
}

enum Frequency {
  none
  daily
  weekly
  monthly
  yearly
}

enum DevicePlatform {
  ios
  android
  web
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  nickname     String   @unique
  role         Role
  managerId    String?  @map("manager_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  /// Set when the Founder deleted the account. The person's work stays, shown as a removed user.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  avatarId     String   @map("avatar_id")
  /// An uploaded picture; shown instead of the catalog avatar when set.
  photoId      String?  @unique @map("photo_id") @db.Uuid
  timeZone     String   @default("America/New_York") @map("time_zone")
  /// Last time the user was connected; used for "last seen" when they are offline.
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  manager            User?               @relation("ManagerTeam", fields: [managerId], references: [id], onDelete: Restrict)
  team               User[]              @relation("ManagerTeam")
  avatar             Avatar              @relation(fields: [avatarId], references: [id])
  photo              Photo?              @relation("UserPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  uploadedPhotos     Photo[]             @relation("PhotoCreatedBy")
  createdBanks       ProfileBank[]       @relation("BankCreatedBy")
  associateCalls     Call[]              @relation("CallAssociate")
  expertCalls        Call[]              @relation("CallExpert")
  createdCalls       Call[]              @relation("CallCreatedBy")
  identities         AuthIdentity[]
  chatImages         ChatImage[]         @relation("ChatImageUploader")
  chatReactions      ChatReaction[]      @relation("ChatReactionUser")
  statusChanges      CallStatusHistory[]
  messages           Message[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]
  pushSubscriptions  WebPushSubscription[]
  refreshTokens      RefreshToken[]
  createdProfiles    Profile[]           @relation("ProfileCreatedBy")
  reviewedProfiles   Profile[]           @relation("ProfileReviewedBy")
  scheduleBlocks     ScheduleBlock[]     @relation("BlockExpert")
  createdBlocks      ScheduleBlock[]     @relation("BlockCreatedBy")
  conversationsA     Conversation[]      @relation("ConversationUserA")
  conversationsB     Conversation[]      @relation("ConversationUserB")
  chatMessages       ChatMessage[]       @relation("ChatMessageSender")
  assignedTodos      Todo[]              @relation("TodoAssignee")
  createdTodos       Todo[]              @relation("TodoCreatedBy")
  auditLogs          AuditLog[]

  @@index([role])
  @@index([managerId])
  @@map("users")
}

model Avatar {
  id         String         @id
  audience   AvatarAudience
  style      String
  seed       String
  background String
  label      String
  sortOrder  Int            @map("sort_order")

  users    User[]
  profiles Profile[]

  @@unique([audience, sortOrder])
  @@map("avatars")
}

model Platform {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  url       String
  priority  Int
  country   String   @db.Char(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  calls             Call[]
  profileStatuses   ProfilePlatformStatus[]

  @@map("platforms")
}

model Profile {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  linkedinUrl     String?       @map("linkedin_url")
  briefExperience String        @default("") @map("brief_experience")
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  gender          String?
  nationality     String?
  location        String?
  education       String?
  careerHistory   String?       @map("career_history")
  /// Superseded by `addresses`; kept until the running API no longer reads it.
  currentAddress  String?       @map("current_address")
  /// The Profile's own email (the one used on the platforms). Not shown to Experts.
  email           String?
  phone           String?
  /// When the Profile started working with us; set to the approval date, editable by the Founder.
  onboardedAt     DateTime?     @map("onboarded_at") @db.Date
  avatarId        String        @map("avatar_id")
  photoId         String?       @unique @map("photo_id") @db.Uuid
  status          ProfileStatus @default(approved)
  /// Deactivated Profiles are visible to Founders only and cannot be booked.
  isActive        Boolean       @default(true) @map("is_active")
  /// Set when the Founder deleted a Profile that already had calls: its personal details are erased,
  /// it leaves every list, and its calls and income stay under a removed name.
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdById     String        @map("created_by") @db.Uuid
  reviewedById    String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatar     Avatar @relation(fields: [avatarId], references: [id])
  photo      Photo? @relation("ProfilePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  banks      ProfileBank[]
  platformStatuses ProfilePlatformStatus[]
  addresses  ProfileAddress[]
  createdBy  User   @relation("ProfileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?  @relation("ProfileReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  calls      Call[]

  @@index([status])
  @@index([createdById])
  @@map("profiles")
}

model Call {
  id                    String     @id @default(uuid()) @db.Uuid
  status                CallStatus @default(on_scheduling)
  platformId            String     @map("platform_id") @db.Uuid
  profileId             String     @map("profile_id") @db.Uuid
  associateId           String     @map("associate_id") @db.Uuid
  expertId              String?    @map("expert_id") @db.Uuid
  scheduledAt           DateTime   @map("scheduled_at") @db.Timestamptz(3)
  durationMinutes       Int        @map("duration_minutes")
  /// Maintained by trigger calls_set_ends_at: scheduled_at + duration.
  endsAt                DateTime   @default(now()) @map("ends_at") @db.Timestamptz(3)
  notes                 String?
  projectDetails        String     @map("project_details")
  platformAssociateName String     @map("platform_associate_name")
  /// What actually reached the bank (USD), entered by the Founder when the call is processed to bank.
  realIncome            Decimal?   @map("real_income") @db.Decimal(12, 2)
  /// Meeting link the Expert adds when the call starts.
  ninjaLink             String?    @map("ninja_link")
  /// Research link set by the Founder; only the Founder and the Expert may read it.
  gptLink               String?    @map("gpt_link")
  /// A special rate for this call only (USD per hour), overriding the Profile's platform rate.
  rateOverride          Decimal?   @map("rate_override") @db.Decimal(12, 2)
  /// Entered by the Expert when finishing: how long the call really took.
  actualDurationMinutes Int?       @map("actual_duration_minutes")
  /// Expert's 1–5 rating of how the call went, plus their answer.
  rating                Int?
  feedback              String?
  createdById          String     @map("created_by") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  platform  Platform            @relation(fields: [platformId], references: [id], onDelete: Restrict)
  profile   Profile             @relation(fields: [profileId], references: [id], onDelete: Restrict)
  associate User                @relation("CallAssociate", fields: [associateId], references: [id], onDelete: Restrict)
  expert    User?               @relation("CallExpert", fields: [expertId], references: [id], onDelete: Restrict)
  createdBy User                @relation("CallCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  history   CallStatusHistory[]
  messages  Message[]

  @@index([status])
  @@index([associateId])
  @@index([expertId])
  @@index([expertId, scheduledAt])
  @@index([scheduledAt])
  @@map("calls")
}

model ScheduleBlock {
  id              String    @id @default(uuid()) @db.Uuid
  expertId        String    @map("expert_id") @db.Uuid
  kind            BlockKind
  note            String?
  timeZone        String    @map("time_zone")
  startDate       DateTime  @map("start_date") @db.Date
  allDay          Boolean   @default(false) @map("all_day")
  startMinute     Int       @map("start_minute")
  durationMinutes Int       @map("duration_minutes")
  frequency       Frequency @default(none)
  interval        Int       @default(1)
  weekdays        Int[]     @default([])
  monthDay        Int?      @map("month_day")
  setPosition     Int?      @map("set_position")
  weekday         Int?
  month           Int?
  untilDate       DateTime? @map("until_date") @db.Date
  exceptionDates  String[]  @default([]) @map("exception_dates")
  createdById     String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  expert    User @relation("BlockExpert", fields: [expertId], references: [id], onDelete: Cascade)
  createdBy User @relation("BlockCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expertId, startDate])
  @@map("schedule_blocks")
}

model CallStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  callId     String      @map("call_id") @db.Uuid
  fromStatus CallStatus? @map("from_status")
  toStatus   CallStatus  @map("to_status")
  actorId    String      @map("actor_id") @db.Uuid
  isOverride Boolean     @default(false) @map("is_override")
  comment    String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  call  Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([callId, createdAt])
  @@map("call_status_history")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  callId    String   @map("call_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  call   Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([callId, createdAt])
  @@map("messages")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  token      String         @unique
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Who did what, when, and from where. Written for every change and for reads of sensitive data.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null for anonymous attempts, e.g. a failed sign-in.
  userId      String?  @map("user_id") @db.Uuid
  actorRole   Role?    @map("actor_role")
  /// Kept even if the account is later renamed.
  actorName   String?  @map("actor_name")
  /// Dotted name of what happened, e.g. `call.transition` or `bank.read`.
  action      String
  summary     String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  method      String
  path        String
  statusCode  Int      @map("status_code")
  ip          String?
  country     String?  @db.Char(2)
  deviceType  String?  @map("device_type")
  userAgent   String?  @map("user_agent")
  sessionId   String?  @map("session_id") @db.Uuid
  /// Extra detail: changed fields, the target user, the attempted email.
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  /// Sessions do not expire on their own; this is a far-future date unless REFRESH_TOKEN_TTL says otherwise.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Where this session signed in from, for the "signed-in devices" list.
  deviceType String?   @map("device_type")
  browser    String?
  os         String?
  ip         String?
  /// Two-letter country from the proxy (Vercel / Cloudflare), when it tells us.
  country    String?   @db.Char(2)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Uploaded avatar pictures, resized by the client (≤ 400 KB).
model Photo {
  id          String   @id @default(uuid()) @db.Uuid
  contentType String   @map("content_type")
  data        Bytes
  byteSize    Int      @map("byte_size")
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User     @relation("PhotoCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  user      User?    @relation("UserPhoto")
  profile   Profile? @relation("ProfilePhoto")

  @@map("photos")
}

/// Where a Profile is paid. Optional, but required once the Profile has a booked call.
model ProfileBank {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  bankName      String   @map("bank_name")
  accountHolder String   @map("account_holder")
  accountNumber String   @map("account_number")
  swiftBic      String?  @map("swift_bic")
  routingNumber String?  @map("routing_number")
  country       String?  @db.Char(2)
  currency      String?  @db.Char(3)
  notes         String?
  /// A closed account is kept for history but no longer counts as a way to pay the Profile.
  isActive      Boolean  @default(true) @map("is_active")
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdById   String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy User    @relation("BankCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([profileId])
  @@map("profile_banks")
}

model ProfilePlatformStatus {
  profileId  String               @map("profile_id") @db.Uuid
  platformId String               @map("platform_id") @db.Uuid
  status     PlatformRegistration @default(not_registered)
  /// Rate per hour (USD) on this platform, required once registered. Never shown to Experts.
  rate       Decimal?             @db.Decimal(12, 2)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([profileId, platformId])
  @@map("profile_platform_statuses")
}

/// A one-to-one chat. The pair is stored once with user_a_id < user_b_id.
model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  userAId         String    @map("user_a_id") @db.Uuid
  userBId         String    @map("user_b_id") @db.Uuid
  userALastReadAt DateTime? @map("user_a_last_read_at") @db.Timestamptz(3)
  userBLastReadAt DateTime? @map("user_b_last_read_at") @db.Timestamptz(3)
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  userA    User          @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User          @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  todos    Todo[]
  images   ChatImage[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("conversations")
}

model ChatMessage {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  senderId       String          @map("sender_id") @db.Uuid
  body           String
  kind           ChatMessageKind @default(text)
  replyToId      String?         @map("reply_to_id") @db.Uuid
  /// A picture sent with the message (the body is then an optional caption).
  imageId        String?         @unique @map("image_id") @db.Uuid
  /// Set when the sender deleted the message; its text and picture are erased.
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo      ChatMessage?  @relation("ChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[] @relation("ChatMessageReply")
  todo         Todo?         @relation("TodoMessage")
  doneFor      Todo?         @relation("TodoDoneMessage")
  image        ChatImage?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  reactions    ChatReaction[]

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// A Founder turned a chat message into a to-do for the other person in the chat.
model Todo {
  id             String     @id @default(uuid()) @db.Uuid
  /// Set when the task was made from a chat message; standalone tasks have a title instead.
  messageId      String?    @unique @map("message_id") @db.Uuid
  conversationId String?    @map("conversation_id") @db.Uuid
  title          String?
  details        String?
  assigneeId     String     @map("assignee_id") @db.Uuid
  createdById    String     @map("created_by") @db.Uuid
  status         TodoStatus @default(open)
  /// Where the task sits on its panel; dragging a task rewrites these (§6.x tasks).
  position       Int        @default(0)
  doneAt         DateTime?  @map("done_at") @db.Timestamptz(3)
  doneNote       String?    @map("done_note")
  /// The chat reply posted when the assignee marked it done.
  doneMessageId  String?    @unique @map("done_message_id") @db.Uuid
  /// When the giver confirmed it done; the task is then completed.
  confirmedAt    DateTime?  @map("confirmed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  message      ChatMessage? @relation("TodoMessage", fields: [messageId], references: [id], onDelete: Cascade)
  doneMessage  ChatMessage? @relation("TodoDoneMessage", fields: [doneMessageId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee     User         @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TodoCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assigneeId, status])
  @@index([assigneeId, position])
  @@index([createdById, status])
  @@map("todos")
}

/// A browser's Web Push subscription (one per browser profile). Moves to whoever signs in last.
model WebPushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

enum DbDumpTrigger {
  scheduled
  manual
}

/// A database dump kept for the Founder (gzipped JSON of every table).
model DbDump {
  id          String        @id @default(uuid()) @db.Uuid
  trigger     DbDumpTrigger @default(scheduled)
  succeeded   Boolean       @default(true)
  error       String?
  byteSize    Int           @map("byte_size")
  tableCounts Json          @map("table_counts")
  /// gzip of the JSON dump; null when the dump failed.
  data        Bytes?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("db_dumps")
}

/// A Profile's postal addresses, each with a label (Home, Mailing…). Founder only.
model ProfileAddress {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  label     String
  address   String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("profile_addresses")
}

/// A way to sign in besides the password, such as a Google account.
enum AuthProvider {
  google
}

/// Links a user to an outside account. The provider's stable `subject` (Google's `sub`) identifies it;
/// the email is only a record of which address it had when linked or last used.
model AuthIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  subject    String
  email      String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

/// A picture sent in a chat, shrunk by the browser before upload. Only the two people in the chat may load it.
model ChatImage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  uploaderId     String   @map("uploader_id") @db.Uuid
  contentType    String   @map("content_type")
  data           Bytes
  byteSize       Int      @map("byte_size")
  width          Int
  height         Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploader     User         @relation("ChatImageUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  message      ChatMessage?

  @@index([conversationId])
  @@map("chat_images")
}

/// One person's emoji reaction to a chat message; each emoji once per person.
model ChatReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation("ChatReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("chat_reactions")
}
